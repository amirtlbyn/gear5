// One bar on every screen. For a compact bar on a vertical screen, see the README.
[
  {
    "margin-top": 0,
    "margin-left": 120,
    "margin-bottom": 0,
    "margin-right": 120,
    "height": 60, 
    "layer": "top",
    "position": "top",
    "spacing": 15,
    "modules-left": ["custom/launcher", "custom/clock", "custom/dates"],
    "modules-center": ["group/desks"],
    "modules-right": ["custom/minimized", "custom/idle", "custom/lang", "pulseaudio", "network", "battery", "custom/powermenu"],
    "include": ["~/.config/waybar/bar/modules.jsonc"]
  }
]
