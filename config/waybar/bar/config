// One bar on every screen; vertical screens get a workspaces-only bar (scripts/bar_config.py).
[
  {
    "margin-top": 0,
    "margin-left": 120,
    "margin-bottom": 0,
    "margin-right": 120,
    "height": 60,
    "layer": "top",
    "position": "top",
    "spacing": 15,
    "reload_style_on_change": true,
    "modules-left": ["custom/launcher", "custom/clock", "custom/idle"],
    "modules-center": ["image#character", "group/desks"],
    "modules-right": ["custom/minimized", "custom/lang", "pulseaudio", "network", "battery", "custom/powermenu"],
    "include": ["~/.config/waybar/bar/modules.jsonc"]
  }
]
